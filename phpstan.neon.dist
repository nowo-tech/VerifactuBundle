includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

# PHPStan configuration for VerifactuBundle
# Compatible with PHP 8.1+ and Symfony 6.x / 7.x / 8.x
# phpstan/extension-installer auto-includes phpstan-symfony and phpstan-phpunit

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
        - tests/Fixtures/app/var/*
        - tests/Fixtures/doctrine-app/var/*
        - tests/Fixtures/**/reference.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
