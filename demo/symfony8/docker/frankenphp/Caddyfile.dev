{
	skip_install_trust
	# Timeout stack (must stay aligned with nowo_verifactu.aeat.timeout):
	#   AEAT SOAP timeout  <  PHP max_execution_time  <  Caddy write timeout
	# Default aeat.timeout = 30s → PHP 45s → write 60s.
	# max_wait_time bounds the queue when workers are busy (avoids endless backlog).
	servers {
		timeouts {
			read_body 60s
			read_header 30s
			write 60s
			idle 5m
		}
	}
	frankenphp {
		php_ini max_execution_time 45
		php_ini max_input_time 45
		max_wait_time 30s
	}
}

:80 {
	root * /app/public
	encode zstd br gzip
	# Disable cache in development so changes are reflected immediately
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	# Classic mode (no worker): each request runs in a new PHP process so the app always responds and file changes are visible
	php_server {
		try_files {path} /index.php
	}
}
