{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title">VerifactuBundle Demo</h1>
        <p class="nowo-ui-muted">Flujo de adopción Nowo: factura → <code class="nowo-ui-code">InvoiceDraft</code> → registro AEAT con cadena de hashes persistente (Doctrine).</p>
    </div>
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" data-testid="demo-system-state">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Estado del sistema</h2></div>
        <div class="nowo-ui-card__body">
            <ul>
                <li>Hash chain (Doctrine): {% if hashChainState %}último registro <code class="nowo-ui-code">{{ hashChainState.invoiceSeriesNumber }}</code> — hash <code class="nowo-ui-code">{{ hashChainState.hash|slice(0, 16) }}…</code>{% else %}sin registros previos{% endif %}</li>
                <li>Certificado AEAT: {% if aeatConfigured %}<strong>configurado</strong> (envío sandbox disponible){% else %}<span class="nowo-ui-badge nowo-ui-badge--warning">no configurado</span> — define <code class="nowo-ui-code">AEAT_CERT_PATH</code> y <code class="nowo-ui-code">AEAT_CERT_PASSWORD</code> en <code class="nowo-ui-code">.env.local</code>{% endif %}</li>
            </ul>
        </div>
    </section>

    <section class="nowo-ui-card" data-testid="demo-invoice-form">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Emitir factura</h2></div>
        <div class="nowo-ui-card__body">
            {{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </section>

    {% if result is not null %}
        {% if result.errors is not empty %}
            <div class="nowo-ui-flash nowo-ui-flash--error" role="alert" data-testid="demo-result-errors">
                <h2>Errores de validación</h2>
                <ul>
                    {% for error in result.errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <section class="nowo-ui-card" data-testid="demo-result">
                <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Registro generado</h2></div>
                <div class="nowo-ui-card__body">
                    <p><strong>Hash:</strong> {{ result.record.hash }}</p>
                    <p><strong>Hash anterior:</strong> {{ result.record.previousHash ?? '(primer registro)' }}</p>
                    {% if result.submission is defined %}
                        <p><strong>Envío AEAT:</strong>
                            {% if result.submission.success %}
                                OK — referencia {{ result.submission.reference ?? '(sin CSV)' }}
                            {% else %}
                                Fallido
                                {% if result.submission.errors is defined %}
                                    <ul>{% for error in result.submission.errors %}<li>{{ error }}</li>{% endfor %}</ul>
                                {% endif %}
                            {% endif %}
                        </p>
                        {% if result.submission.endpoint is defined %}
                            <p class="nowo-ui-muted">Endpoint: {{ result.submission.endpoint }}</p>
                        {% endif %}
                    {% endif %}
                    {% if qrDataUri %}
                        <div>
                            <img src="{{ qrDataUri }}" alt="QR Veri*Factu" width="140" height="140">
                            <p class="nowo-ui-muted">{{ verifactu_legend() }}</p>
                            <p><a class="nowo-ui-link" href="{{ verifactu_qr_url(result.record) }}" target="_blank" rel="noopener">Abrir URL de verificación AEAT</a></p>
                        </div>
                    {% endif %}
                    <h3>XML</h3>
                    <pre class="nowo-ui-code">{{ result.record.xml|e }}</pre>
                    {% if result.record.signedXml %}
                        <h3>XML firmado (XAdES)</h3>
                        <pre class="nowo-ui-code">{{ result.record.signedXml|e }}</pre>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
