{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'VerifactuBundle Demo',
        intro: 'Flujo de adopción Nowo: factura → InvoiceDraft → registro AEAT con cadena de hashes persistente (Doctrine).',
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {# Validation errors of the billing service are shown as shell flashes, under the page header. #}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: result is not null and result.errors is not empty ? {error: result.errors} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Estado del sistema', kind: 'detail', testid: 'demo-system-state'} %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item">
                    <dt class="nowo-ui-detail-list__term">Hash chain (Doctrine)</dt>
                    <dd class="nowo-ui-detail-list__value">{% if hashChainState %}último registro <code class="nowo-ui-code">{{ hashChainState.invoiceSeriesNumber }}</code> — hash <code class="nowo-ui-code">{{ hashChainState.hash|slice(0, 16) }}…</code>{% else %}sin registros previos{% endif %}</dd>
                </div>
                <div class="nowo-ui-detail-list__item">
                    <dt class="nowo-ui-detail-list__term">Certificado AEAT</dt>
                    <dd class="nowo-ui-detail-list__value">{% if aeatConfigured %}<span class="nowo-ui-badge nowo-ui-badge--success">configurado</span> envío sandbox disponible{% else %}<span class="nowo-ui-badge nowo-ui-badge--warning">no configurado</span> define <code class="nowo-ui-code">AEAT_CERT_PATH</code> y <code class="nowo-ui-code">AEAT_CERT_PASSWORD</code> en <code class="nowo-ui-code">.env.local</code>{% endif %}</dd>
                </div>
            </dl>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Emitir factura', kind: 'form', testid: 'demo-invoice-form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'invoice-form', class: 'nowo-ui-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="invoice-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}

    {% if result is not null and result.errors is empty %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Registro generado', kind: 'detail', testid: 'demo-result'} %}
            {% block section_body %}
                <dl class="nowo-ui-detail-list">
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Hash:</dt><dd class="nowo-ui-detail-list__value">{{ result.record.hash }}</dd></div>
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Hash anterior:</dt><dd class="nowo-ui-detail-list__value">{{ result.record.previousHash ?? '(primer registro)' }}</dd></div>
                    {% if result.submission is defined %}
                        <div class="nowo-ui-detail-list__item">
                            <dt class="nowo-ui-detail-list__term">Envío AEAT:</dt>
                            <dd class="nowo-ui-detail-list__value">
                                {% if result.submission.success %}
                                    <span class="nowo-ui-badge nowo-ui-badge--success">OK</span> referencia {{ result.submission.reference ?? '(sin CSV)' }}
                                {% else %}
                                    <span class="nowo-ui-badge nowo-ui-badge--danger">Fallido</span>
                                    {% if result.submission.errors is defined %}
                                        <ul>{% for error in result.submission.errors %}<li>{{ error }}</li>{% endfor %}</ul>
                                    {% endif %}
                                {% endif %}
                                {% if result.submission.endpoint is defined %}
                                    <div class="nowo-ui-muted">Endpoint: {{ result.submission.endpoint }}</div>
                                {% endif %}
                            </dd>
                        </div>
                    {% endif %}
                </dl>
                {% if qrDataUri %}
                    <div>
                        <img src="{{ qrDataUri }}" alt="QR Veri*Factu" width="140" height="140">
                        <p class="nowo-ui-muted">{{ verifactu_legend() }}</p>
                        <p><a class="nowo-ui-link" href="{{ verifactu_qr_url(result.record) }}" target="_blank" rel="noopener">Abrir URL de verificación AEAT</a></p>
                    </div>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'XML', kind: 'table', testid: 'demo-result-xml'} %}
            {% block section_body %}<pre class="nowo-ui-code">{{ result.record.xml|e }}</pre>{% endblock %}
        {% endembed %}

        {% if result.record.signedXml %}
            {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'XML firmado (XAdES)', kind: 'table', testid: 'demo-result-signed-xml'} %}
                {% block section_body %}<pre class="nowo-ui-code">{{ result.record.signedXml|e }}</pre>{% endblock %}
            {% endembed %}
        {% endif %}
    {% endif %}
{% endblock %}
