<?xml version="1.0" encoding="UTF-8"?>
<!-- XML mapping of the record log (nowo_verifactu.doctrine.mapping: xml). Keep in sync with the attributes on
     Nowo\VerifactuBundle\Entity\BillingRecordEntry. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\VerifactuBundle\Entity\BillingRecordEntry" table="verifactu_billing_record">
        <unique-constraints>
            <unique-constraint name="uniq_verifactu_billing_record_hash" columns="issuer_nif,hash"/>
        </unique-constraints>
        <indexes>
            <index name="idx_verifactu_billing_record_submission" columns="issuer_nif,submission_status,position"/>
        </indexes>
        <id name="issuerNif" column="issuer_nif" type="string" length="20"/>
        <id name="position" column="position" type="integer"/>
        <field name="recordType" column="record_type" type="string" length="10"/>
        <field name="invoiceSeriesNumber" column="invoice_series_number" type="string" length="60"/>
        <field name="issueDate" column="issue_date" type="string" length="10"/>
        <field name="invoiceType" column="invoice_type" type="string" length="2"/>
        <field name="totalTaxAmount" column="total_tax_amount" type="string" length="20"/>
        <field name="totalAmount" column="total_amount" type="string" length="20"/>
        <field name="generatedAt" column="generated_at" type="string" length="32"/>
        <field name="previousHash" column="previous_hash" type="string" length="64"/>
        <field name="hash" column="hash" type="string" length="64"/>
        <field name="issuerName" column="issuer_name" type="string" length="120" nullable="true"/>
        <field name="xml" column="xml" type="text"/>
        <field name="signedXml" column="signed_xml" type="text" nullable="true"/>
        <field name="submissionStatus" column="submission_status" type="string" length="16"/>
        <field name="submissionReference" column="submission_reference" type="string" length="120" nullable="true"/>
        <field name="environment" column="environment" type="string" length="10" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="submissionAttempts" column="submission_attempts" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="submissionClaim" column="submission_claim" type="string" length="32" nullable="true"/>
        <field name="submissionClaimedAt" column="submission_claimed_at" type="datetime_immutable" nullable="true"/>
        <field name="submissionErrorCode" column="submission_error_code" type="integer" nullable="true"/>
        <field name="submissionError" column="submission_error" type="text" nullable="true"/>
        <field name="submissionFailures" column="submission_failures" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="submittedAt" column="submitted_at" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
