<?xml version="1.0" encoding="UTF-8"?>
<!-- XML mapping of the chain head (nowo_verifactu.doctrine.mapping: xml). Keep in sync with the attributes on
     Nowo\VerifactuBundle\Entity\BillingRecordHashChain. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\VerifactuBundle\Entity\BillingRecordHashChain"
            table="verifactu_hash_chain"
            repository-class="Nowo\VerifactuBundle\Repository\DoctrineHashChainRepository">
        <unique-constraints>
            <unique-constraint name="uniq_verifactu_hash_chain_issuer" columns="issuer_nif"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="issuerNif" column="issuer_nif" type="string" length="20"/>
        <field name="invoiceSeriesNumber" column="invoice_series_number" type="string" length="60"/>
        <field name="issueDate" column="issue_date" type="string" length="10"/>
        <field name="hash" column="hash" type="string" length="64"/>
        <field name="environment" column="environment" type="string" length="10" nullable="true"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
